# Retrieval
CHROMA_DB_PATH=./data/indexes/chroma
RAW_DOCS_PATH=./data/raw
RAG_TOP_K=5
RAG_FETCH_K=20
RAG_MAX_CHUNKS_PER_SOURCE=2

# Embeddings: multilingual model recommended for English + Japanese.
# Use sentence_transformers for quality, or hash for a lightweight smoke test.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# LLM provider: llama_cpp, ollama, or context
# context is a deterministic smoke-test provider, not a real LLM.
LLM_PROVIDER=llama_cpp

# llama.cpp provider
GEMMA_GGUF_PATH=./models/llm/gemma-2b-it-q4.gguf
LLAMA_CPP_N_CTX=4096
LLAMA_CPP_N_THREADS=4
LLAMA_CPP_MAX_TOKENS=512
LLAMA_CPP_REPEAT_PENALTY=1.1
LLAMA_CPP_FORCE_CPU_DEVICES=true

# Model downloader defaults. For this Intel iMac, prefer a quantized GGUF.
HF_MODEL_REPO_ID=bartowski/gemma-2-2b-it-GGUF
HF_MODEL_FILENAME=gemma-2-2b-it-Q4_K_M.gguf

# Ollama-compatible provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma:2b
